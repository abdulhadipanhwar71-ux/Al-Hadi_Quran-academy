MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=alhadi_academy_db
MYSQL_TEST_DATABASE=alhadi_academy_test_db

# Initial Administrator Information
ADMIN_USERNAME=abdulhadi
ADMIN_EMAIL=abdulhadipanhwar71@gmail.com
