[{"id": 5968, "surah_number": 88, "ayah_number_in_surah": 1, "global_ayah_number": 5968, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "text_urdu": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے", "text_english": "Has there reached you the report of the Overwhelming [event]?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5968.mp3"}, {"id": 5969, "surah_number": 88, "ayah_number_in_surah": 2, "global_ayah_number": 5969, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "text_urdu": "اس روز بہت سے منہ (والے) ذلیل ہوں گے", "text_english": "[Some] faces, that Day, will be humbled,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5969.mp3"}, {"id": 5970, "surah_number": 88, "ayah_number_in_surah": 3, "global_ayah_number": 5970, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "text_urdu": "سخت محنت کرنے والے تھکے ماندے", "text_english": "Working [hard] and exhausted.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5970.mp3"}, {"id": 5971, "surah_number": 88, "ayah_number_in_surah": 4, "global_ayah_number": 5971, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "text_urdu": "دہکتی آگ میں داخل ہوں گے", "text_english": "They will [enter to] burn in an intensely hot Fire.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5971.mp3"}, {"id": 5972, "surah_number": 88, "ayah_number_in_surah": 5, "global_ayah_number": 5972, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "text_urdu": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا", "text_english": "They will be given drink from a boiling spring.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5972.mp3"}, {"id": 5973, "surah_number": 88, "ayah_number_in_surah": 6, "global_ayah_number": 5973, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "text_urdu": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)", "text_english": "For them there will be no food except from a poisonous, thorny plant", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5973.mp3"}, {"id": 5974, "surah_number": 88, "ayah_number_in_surah": 7, "global_ayah_number": 5974, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "text_urdu": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے", "text_english": "Which neither nourishes nor avails against hunger.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5974.mp3"}, {"id": 5975, "surah_number": 88, "ayah_number_in_surah": 8, "global_ayah_number": 5975, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "text_urdu": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے", "text_english": "[Other] faces, that Day, will show pleasure.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5975.mp3"}, {"id": 5976, "surah_number": 88, "ayah_number_in_surah": 9, "global_ayah_number": 5976, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "لِّسَعْيِهَا رَاضِيَةٌۭ", "text_urdu": "اپنے اعمال (کی جزا) سے خوش دل", "text_english": "With their effort [they are] satisfied", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5976.mp3"}, {"id": 5977, "surah_number": 88, "ayah_number_in_surah": 10, "global_ayah_number": 5977, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "فِى جَنَّةٍ عَالِيَةٍۢ", "text_urdu": "بہشت بریں میں", "text_english": "In an elevated garden,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5977.mp3"}, {"id": 5978, "surah_number": 88, "ayah_number_in_surah": 11, "global_ayah_number": 5978, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "text_urdu": "وہاں کسی طرح کی بکواس نہیں سنیں گے", "text_english": "Wherein they will hear no unsuitable speech.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5978.mp3"}, {"id": 5979, "surah_number": 88, "ayah_number_in_surah": 12, "global_ayah_number": 5979, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "text_urdu": "اس میں چشمے بہ رہے ہوں گے", "text_english": "Within it is a flowing spring.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5979.mp3"}, {"id": 5980, "surah_number": 88, "ayah_number_in_surah": 13, "global_ayah_number": 5980, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "text_urdu": "وہاں تخت ہوں گے اونچے بچھے ہوئے", "text_english": "Within it are couches raised high", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5980.mp3"}, {"id": 5981, "surah_number": 88, "ayah_number_in_surah": 14, "global_ayah_number": 5981, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "text_urdu": "اور آبخورے (قرینے سے) رکھے ہوئے", "text_english": "And cups put in place", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5981.mp3"}, {"id": 5982, "surah_number": 88, "ayah_number_in_surah": 15, "global_ayah_number": 5982, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "text_urdu": "اور گاؤ تکیے قطار کی قطار لگے ہوئے", "text_english": "And cushions lined up", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5982.mp3"}, {"id": 5983, "surah_number": 88, "ayah_number_in_surah": 16, "global_ayah_number": 5983, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ", "text_urdu": "اور نفیس مسندیں بچھی ہوئی", "text_english": "And carpets spread around.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5983.mp3"}, {"id": 5984, "surah_number": 88, "ayah_number_in_surah": 17, "global_ayah_number": 5984, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "text_urdu": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں", "text_english": "Then do they not look at the camels - how they are created?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5984.mp3"}, {"id": 5985, "surah_number": 88, "ayah_number_in_surah": 18, "global_ayah_number": 5985, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "text_urdu": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے", "text_english": "And at the sky - how it is raised?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5985.mp3"}, {"id": 5986, "surah_number": 88, "ayah_number_in_surah": 19, "global_ayah_number": 5986, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "text_urdu": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں", "text_english": "And at the mountains - how they are erected?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5986.mp3"}, {"id": 5987, "surah_number": 88, "ayah_number_in_surah": 20, "global_ayah_number": 5987, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "text_urdu": "اور زمین کی طرف کہ کس طرح بچھائی گئی", "text_english": "And at the earth - how it is spread out?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5987.mp3"}, {"id": 5988, "surah_number": 88, "ayah_number_in_surah": 21, "global_ayah_number": 5988, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "text_urdu": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو", "text_english": "So remind, [O Muhammad]; you are only a reminder.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5988.mp3"}, {"id": 5989, "surah_number": 88, "ayah_number_in_surah": 22, "global_ayah_number": 5989, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "text_urdu": "تم ان پر داروغہ نہیں ہو", "text_english": "You are not over them a controller.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5989.mp3"}, {"id": 5990, "surah_number": 88, "ayah_number_in_surah": 23, "global_ayah_number": 5990, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "text_urdu": "ہاں جس نے منہ پھیرا اور نہ مانا", "text_english": "However, he who turns away and disbelieves -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5990.mp3"}, {"id": 5991, "surah_number": 88, "ayah_number_in_surah": 24, "global_ayah_number": 5991, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "text_urdu": "تو خدا اس کو بڑا عذاب دے گا", "text_english": "Then Allah will punish him with the greatest punishment.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5991.mp3"}, {"id": 5992, "surah_number": 88, "ayah_number_in_surah": 25, "global_ayah_number": 5992, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "text_urdu": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے", "text_english": "Indeed, to Us is their return.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5992.mp3"}, {"id": 5993, "surah_number": 88, "ayah_number_in_surah": 26, "global_ayah_number": 5993, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "sajda": false, "text_arabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "text_urdu": "پھر ہم ہی کو ان سے حساب لینا ہے", "text_english": "Then indeed, upon Us is their account.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5993.mp3"}]