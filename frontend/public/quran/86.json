[{"id": 5932, "surah_number": 86, "ayah_number_in_surah": 1, "global_ayah_number": 5932, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ", "text_urdu": "آسمان اور رات کے وقت آنے والے کی قسم", "text_english": "By the sky and the night comer -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5932.mp3"}, {"id": 5933, "surah_number": 86, "ayah_number_in_surah": 2, "global_ayah_number": 5933, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "text_urdu": "اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے", "text_english": "And what can make you know what is the night comer?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5933.mp3"}, {"id": 5934, "surah_number": 86, "ayah_number_in_surah": 3, "global_ayah_number": 5934, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "ٱلنَّجْمُ ٱلثَّاقِبُ", "text_urdu": "وہ تارا ہے چمکنے والا", "text_english": "It is the piercing star -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5934.mp3"}, {"id": 5935, "surah_number": 86, "ayah_number_in_surah": 4, "global_ayah_number": 5935, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "text_urdu": "کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں", "text_english": "There is no soul but that it has over it a protector.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5935.mp3"}, {"id": 5936, "surah_number": 86, "ayah_number_in_surah": 5, "global_ayah_number": 5936, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "text_urdu": "تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے", "text_english": "So let man observe from what he was created.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5936.mp3"}, {"id": 5937, "surah_number": 86, "ayah_number_in_surah": 6, "global_ayah_number": 5937, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "text_urdu": "وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے", "text_english": "He was created from a fluid, ejected,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5937.mp3"}, {"id": 5938, "surah_number": 86, "ayah_number_in_surah": 7, "global_ayah_number": 5938, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "text_urdu": "جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے", "text_english": "Emerging from between the backbone and the ribs.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5938.mp3"}, {"id": 5939, "surah_number": 86, "ayah_number_in_surah": 8, "global_ayah_number": 5939, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "text_urdu": "بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے", "text_english": "Indeed, Allah, to return him [to life], is Able.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5939.mp3"}, {"id": 5940, "surah_number": 86, "ayah_number_in_surah": 9, "global_ayah_number": 5940, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "text_urdu": "جس دن دلوں کے بھید جانچے جائیں گے", "text_english": "The Day when secrets will be put on trial,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5940.mp3"}, {"id": 5941, "surah_number": 86, "ayah_number_in_surah": 10, "global_ayah_number": 5941, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "text_urdu": "تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا", "text_english": "Then man will have no power or any helper.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5941.mp3"}, {"id": 5942, "surah_number": 86, "ayah_number_in_surah": 11, "global_ayah_number": 5942, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "text_urdu": "آسمان کی قسم جو مینہ برساتا ہے", "text_english": "By the sky which returns [rain]", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5942.mp3"}, {"id": 5943, "surah_number": 86, "ayah_number_in_surah": 12, "global_ayah_number": 5943, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "text_urdu": "اور زمین کی قسم جو پھٹ جاتی ہے", "text_english": "And [by] the earth which cracks open,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5943.mp3"}, {"id": 5944, "surah_number": 86, "ayah_number_in_surah": 13, "global_ayah_number": 5944, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "text_urdu": "کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے", "text_english": "Indeed, the Qur'an is a decisive statement,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5944.mp3"}, {"id": 5945, "surah_number": 86, "ayah_number_in_surah": 14, "global_ayah_number": 5945, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "وَمَا هُوَ بِٱلْهَزْلِ", "text_urdu": "اور بیہودہ بات نہیں ہے", "text_english": "And it is not amusement.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5945.mp3"}, {"id": 5946, "surah_number": 86, "ayah_number_in_surah": 15, "global_ayah_number": 5946, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "text_urdu": "یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں", "text_english": "Indeed, they are planning a plan,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5946.mp3"}, {"id": 5947, "surah_number": 86, "ayah_number_in_surah": 16, "global_ayah_number": 5947, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "وَأَكِيدُ كَيْدًۭا", "text_urdu": "اور ہم اپنی تدبیر کر رہے ہیں", "text_english": "But I am planning a plan.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5947.mp3"}, {"id": 5948, "surah_number": 86, "ayah_number_in_surah": 17, "global_ayah_number": 5948, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "sajda": false, "text_arabic": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "text_urdu": "تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو", "text_english": "So allow time for the disbelievers. Leave them awhile.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5948.mp3"}]