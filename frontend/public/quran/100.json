[{"id": 6147, "surah_number": 100, "ayah_number_in_surah": 1, "global_ayah_number": 6147, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "text_urdu": "ان سرپٹ دوڑنے والے گھوڑوں کی قسم جو ہانپ اٹھتےہیں", "text_english": "By the racers, panting,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6147.mp3"}, {"id": 6148, "surah_number": 100, "ayah_number_in_surah": 2, "global_ayah_number": 6148, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "text_urdu": "پھر (پتھروں پر نعل) مار کر آگ نکالتے ہیں", "text_english": "And the producers of sparks [when] striking", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6148.mp3"}, {"id": 6149, "surah_number": 100, "ayah_number_in_surah": 3, "global_ayah_number": 6149, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "text_urdu": "پھر صبح کو چھاپہ مارتے ہیں", "text_english": "And the chargers at dawn,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6149.mp3"}, {"id": 6150, "surah_number": 100, "ayah_number_in_surah": 4, "global_ayah_number": 6150, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "text_urdu": "پھر اس میں گرد اٹھاتے ہیں", "text_english": "Stirring up thereby [clouds of] dust,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6150.mp3"}, {"id": 6151, "surah_number": 100, "ayah_number_in_surah": 5, "global_ayah_number": 6151, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "فَوَسَطْنَ بِهِۦ جَمْعًا", "text_urdu": "پھر اس وقت دشمن کی فوج میں جا گھستے ہیں", "text_english": "Arriving thereby in the center collectively,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6151.mp3"}, {"id": 6152, "surah_number": 100, "ayah_number_in_surah": 6, "global_ayah_number": 6152, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "text_urdu": "کہ انسان اپنے پروردگار کا احسان ناشناس (اور ناشکرا) ہے", "text_english": "Indeed mankind, to his Lord, is ungrateful.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6152.mp3"}, {"id": 6153, "surah_number": 100, "ayah_number_in_surah": 7, "global_ayah_number": 6153, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "text_urdu": "اور وہ اس سے آگاہ بھی ہے", "text_english": "And indeed, he is to that a witness.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6153.mp3"}, {"id": 6154, "surah_number": 100, "ayah_number_in_surah": 8, "global_ayah_number": 6154, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "text_urdu": "وہ تو مال سے سخت محبت کرنے والا ہے", "text_english": "And indeed he is, in love of wealth, intense.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6154.mp3"}, {"id": 6155, "surah_number": 100, "ayah_number_in_surah": 9, "global_ayah_number": 6155, "juz": 30, "manzil": 7, "page": 599, "ruku": 542, "sajda": false, "text_arabic": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "text_urdu": "کیا وہ اس وقت کو نہیں جانتا کہ جو (مردے) قبروں میں ہیں وہ باہر نکال لیے جائیں گے", "text_english": "But does he not know that when the contents of the graves are scattered", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6155.mp3"}, {"id": 6156, "surah_number": 100, "ayah_number_in_surah": 10, "global_ayah_number": 6156, "juz": 30, "manzil": 7, "page": 600, "ruku": 542, "sajda": false, "text_arabic": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "text_urdu": "اور جو (بھید) دلوں میں ہیں وہ ظاہر کر دیئے جائیں گے", "text_english": "And that within the breasts is obtained,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6156.mp3"}, {"id": 6157, "surah_number": 100, "ayah_number_in_surah": 11, "global_ayah_number": 6157, "juz": 30, "manzil": 7, "page": 600, "ruku": 542, "sajda": false, "text_arabic": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "text_urdu": "بےشک ان کا پروردگار اس روز ان سے خوب واقف ہوگا", "text_english": "Indeed, their Lord with them, that Day, is [fully] Acquainted.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6157.mp3"}]