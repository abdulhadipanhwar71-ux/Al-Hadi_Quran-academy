[{"id": 6080, "surah_number": 93, "ayah_number_in_surah": 1, "global_ayah_number": 6080, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ", "text_urdu": "آفتاب کی روشنی کی قسم", "text_english": "By the morning brightness", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6080.mp3"}, {"id": 6081, "surah_number": 93, "ayah_number_in_surah": 2, "global_ayah_number": 6081, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَٱلَّيْلِ إِذَا سَجَىٰ", "text_urdu": "اور رات (کی تاریکی) کی جب چھا جائے", "text_english": "And [by] the night when it covers with darkness,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6081.mp3"}, {"id": 6082, "surah_number": 93, "ayah_number_in_surah": 3, "global_ayah_number": 6082, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "text_urdu": "کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ (تم سے) ناراض ہوا", "text_english": "Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6082.mp3"}, {"id": 6083, "surah_number": 93, "ayah_number_in_surah": 4, "global_ayah_number": 6083, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ", "text_urdu": "اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے", "text_english": "And the Hereafter is better for you than the first [life].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6083.mp3"}, {"id": 6084, "surah_number": 93, "ayah_number_in_surah": 5, "global_ayah_number": 6084, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ", "text_urdu": "اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے", "text_english": "And your Lord is going to give you, and you will be satisfied.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6084.mp3"}, {"id": 6085, "surah_number": 93, "ayah_number_in_surah": 6, "global_ayah_number": 6085, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ", "text_urdu": "بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)", "text_english": "Did He not find you an orphan and give [you] refuge?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6085.mp3"}, {"id": 6086, "surah_number": 93, "ayah_number_in_surah": 7, "global_ayah_number": 6086, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ", "text_urdu": "اور رستے سے ناواقف دیکھا تو رستہ دکھایا", "text_english": "And He found you lost and guided [you],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6086.mp3"}, {"id": 6087, "surah_number": 93, "ayah_number_in_surah": 8, "global_ayah_number": 6087, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ", "text_urdu": "اور تنگ دست پایا تو غنی کر دیا", "text_english": "And He found you poor and made [you] self-sufficient.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6087.mp3"}, {"id": 6088, "surah_number": 93, "ayah_number_in_surah": 9, "global_ayah_number": 6088, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ", "text_urdu": "تو تم بھی یتیم پر ستم نہ کرنا", "text_english": "So as for the orphan, do not oppress [him].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6088.mp3"}, {"id": 6089, "surah_number": 93, "ayah_number_in_surah": 10, "global_ayah_number": 6089, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ", "text_urdu": "اور مانگنے والے کو جھڑکی نہ دینا", "text_english": "And as for the petitioner, do not repel [him].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6089.mp3"}, {"id": 6090, "surah_number": 93, "ayah_number_in_surah": 11, "global_ayah_number": 6090, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "sajda": false, "text_arabic": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "text_urdu": "اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا", "text_english": "But as for the favor of your Lord, report [it].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6090.mp3"}]