[{"id": 6180, "surah_number": 104, "ayah_number_in_surah": 1, "global_ayah_number": 6180, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "text_urdu": "ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے", "text_english": "Woe to every scorner and mocker", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6180.mp3"}, {"id": 6181, "surah_number": 104, "ayah_number_in_surah": 2, "global_ayah_number": 6181, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "text_urdu": "جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے", "text_english": "Who collects wealth and [continuously] counts it.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6181.mp3"}, {"id": 6182, "surah_number": 104, "ayah_number_in_surah": 3, "global_ayah_number": 6182, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "text_urdu": "(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا", "text_english": "He thinks that his wealth will make him immortal.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6182.mp3"}, {"id": 6183, "surah_number": 104, "ayah_number_in_surah": 4, "global_ayah_number": 6183, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "text_urdu": "ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا", "text_english": "No! He will surely be thrown into the Crusher.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6183.mp3"}, {"id": 6184, "surah_number": 104, "ayah_number_in_surah": 5, "global_ayah_number": 6184, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "text_urdu": "اور تم کیا سمجھے حطمہ کیا ہے؟", "text_english": "And what can make you know what is the Crusher?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6184.mp3"}, {"id": 6185, "surah_number": 104, "ayah_number_in_surah": 6, "global_ayah_number": 6185, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "text_urdu": "وہ خدا کی بھڑکائی ہوئی آگ ہے", "text_english": "It is the fire of Allah, [eternally] fueled,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6185.mp3"}, {"id": 6186, "surah_number": 104, "ayah_number_in_surah": 7, "global_ayah_number": 6186, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "text_urdu": "جو دلوں پر جا لپٹے گی", "text_english": "Which mounts directed at the hearts.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6186.mp3"}, {"id": 6187, "surah_number": 104, "ayah_number_in_surah": 8, "global_ayah_number": 6187, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "text_urdu": "(اور) وہ اس میں بند کر دیئے جائیں گے", "text_english": "Indeed, Hellfire will be closed down upon them", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6187.mp3"}, {"id": 6188, "surah_number": 104, "ayah_number_in_surah": 9, "global_ayah_number": 6188, "juz": 30, "manzil": 7, "page": 601, "ruku": 546, "sajda": false, "text_arabic": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "text_urdu": "(یعنی آگ کے) لمبے لمبے ستونوں میں", "text_english": "In extended columns.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6188.mp3"}]