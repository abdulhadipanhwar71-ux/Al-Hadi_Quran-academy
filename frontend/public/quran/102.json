[{"id": 6169, "surah_number": 102, "ayah_number_in_surah": 1, "global_ayah_number": 6169, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "text_urdu": "(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا", "text_english": "Competition in [worldly] increase diverts you", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6169.mp3"}, {"id": 6170, "surah_number": 102, "ayah_number_in_surah": 2, "global_ayah_number": 6170, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "text_urdu": "یہاں تک کہ تم نے قبریں جا دیکھیں", "text_english": "Until you visit the graveyards.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6170.mp3"}, {"id": 6171, "surah_number": 102, "ayah_number_in_surah": 3, "global_ayah_number": 6171, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "كَلَّا سَوْفَ تَعْلَمُونَ", "text_urdu": "دیکھو تمہیں عنقریب معلوم ہو جائے گا", "text_english": "No! You are going to know.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6171.mp3"}, {"id": 6172, "surah_number": 102, "ayah_number_in_surah": 4, "global_ayah_number": 6172, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "text_urdu": "پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا", "text_english": "Then no! You are going to know.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6172.mp3"}, {"id": 6173, "surah_number": 102, "ayah_number_in_surah": 5, "global_ayah_number": 6173, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "text_urdu": "دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)", "text_english": "No! If you only knew with knowledge of certainty...", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6173.mp3"}, {"id": 6174, "surah_number": 102, "ayah_number_in_surah": 6, "global_ayah_number": 6174, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "لَتَرَوُنَّ ٱلْجَحِيمَ", "text_urdu": "تم ضرور دوزخ کو دیکھو گے", "text_english": "You will surely see the Hellfire.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6174.mp3"}, {"id": 6175, "surah_number": 102, "ayah_number_in_surah": 7, "global_ayah_number": 6175, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "text_urdu": "پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)", "text_english": "Then you will surely see it with the eye of certainty.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6175.mp3"}, {"id": 6176, "surah_number": 102, "ayah_number_in_surah": 8, "global_ayah_number": 6176, "juz": 30, "manzil": 7, "page": 600, "ruku": 544, "sajda": false, "text_arabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "text_urdu": "پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی", "text_english": "Then you will surely be asked that Day about pleasure.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6176.mp3"}]