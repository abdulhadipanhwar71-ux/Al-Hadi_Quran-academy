[{"id": 5830, "surah_number": 82, "ayah_number_in_surah": 1, "global_ayah_number": 5830, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "text_urdu": "جب آسمان پھٹ جائے گا", "text_english": "When the sky breaks apart", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5830.mp3"}, {"id": 5831, "surah_number": 82, "ayah_number_in_surah": 2, "global_ayah_number": 5831, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "text_urdu": "اور جب تارے جھڑ پڑیں گے", "text_english": "And when the stars fall, scattering,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5831.mp3"}, {"id": 5832, "surah_number": 82, "ayah_number_in_surah": 3, "global_ayah_number": 5832, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "text_urdu": "اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے", "text_english": "And when the seas are erupted", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5832.mp3"}, {"id": 5833, "surah_number": 82, "ayah_number_in_surah": 4, "global_ayah_number": 5833, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "text_urdu": "اور جب قبریں اکھیڑ دی جائیں گی", "text_english": "And when the [contents of] graves are scattered,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5833.mp3"}, {"id": 5834, "surah_number": 82, "ayah_number_in_surah": 5, "global_ayah_number": 5834, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "text_urdu": "تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا", "text_english": "A soul will [then] know what it has put forth and kept back.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5834.mp3"}, {"id": 5835, "surah_number": 82, "ayah_number_in_surah": 6, "global_ayah_number": 5835, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "text_urdu": "اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا", "text_english": "O mankind, what has deceived you concerning your Lord, the Generous,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5835.mp3"}, {"id": 5836, "surah_number": 82, "ayah_number_in_surah": 7, "global_ayah_number": 5836, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "text_urdu": "(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا", "text_english": "Who created you, proportioned you, and balanced you?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5836.mp3"}, {"id": 5837, "surah_number": 82, "ayah_number_in_surah": 8, "global_ayah_number": 5837, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "text_urdu": "اور جس صورت میں چاہا تجھے جوڑ دیا", "text_english": "In whatever form He willed has He assembled you.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5837.mp3"}, {"id": 5838, "surah_number": 82, "ayah_number_in_surah": 9, "global_ayah_number": 5838, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "text_urdu": "مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو", "text_english": "No! But you deny the Recompense.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5838.mp3"}, {"id": 5839, "surah_number": 82, "ayah_number_in_surah": 10, "global_ayah_number": 5839, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "text_urdu": "حالانکہ تم پر نگہبان مقرر ہیں", "text_english": "And indeed, [appointed] over you are keepers,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5839.mp3"}, {"id": 5840, "surah_number": 82, "ayah_number_in_surah": 11, "global_ayah_number": 5840, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "كِرَامًۭا كَٰتِبِينَ", "text_urdu": "عالی قدر (تمہاری باتوں کے) لکھنے والے", "text_english": "Noble and recording;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5840.mp3"}, {"id": 5841, "surah_number": 82, "ayah_number_in_surah": 12, "global_ayah_number": 5841, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "يَعْلَمُونَ مَا تَفْعَلُونَ", "text_urdu": "جو تم کرتے ہو وہ اسے جانتے ہیں", "text_english": "They know whatever you do.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5841.mp3"}, {"id": 5842, "surah_number": 82, "ayah_number_in_surah": 13, "global_ayah_number": 5842, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "text_urdu": "بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔", "text_english": "Indeed, the righteous will be in pleasure,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5842.mp3"}, {"id": 5843, "surah_number": 82, "ayah_number_in_surah": 14, "global_ayah_number": 5843, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "text_urdu": "اور بدکردار دوزخ میں", "text_english": "And indeed, the wicked will be in Hellfire.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5843.mp3"}, {"id": 5844, "surah_number": 82, "ayah_number_in_surah": 15, "global_ayah_number": 5844, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "text_urdu": "(یعنی) جزا کے دن اس میں داخل ہوں گے", "text_english": "They will [enter to] burn therein on the Day of Recompense,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5844.mp3"}, {"id": 5845, "surah_number": 82, "ayah_number_in_surah": 16, "global_ayah_number": 5845, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "text_urdu": "اور اس سے چھپ نہیں سکیں گے", "text_english": "And never therefrom will they be absent.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5845.mp3"}, {"id": 5846, "surah_number": 82, "ayah_number_in_surah": 17, "global_ayah_number": 5846, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "text_urdu": "اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟", "text_english": "And what can make you know what is the Day of Recompense?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5846.mp3"}, {"id": 5847, "surah_number": 82, "ayah_number_in_surah": 18, "global_ayah_number": 5847, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "text_urdu": "پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟", "text_english": "Then, what can make you know what is the Day of Recompense?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5847.mp3"}, {"id": 5848, "surah_number": 82, "ayah_number_in_surah": 19, "global_ayah_number": 5848, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "sajda": false, "text_arabic": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "text_urdu": "جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا", "text_english": "It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5848.mp3"}]