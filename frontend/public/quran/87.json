[{"id": 5949, "surah_number": 87, "ayah_number_in_surah": 1, "global_ayah_number": 5949, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "text_urdu": "(اے پیغمبر) اپنے پروردگار جلیل الشان کے نام کی تسبیح کرو", "text_english": "Exalt the name of your Lord, the Most High,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5949.mp3"}, {"id": 5950, "surah_number": 87, "ayah_number_in_surah": 2, "global_ayah_number": 5950, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "text_urdu": "جس نے (انسان کو) بنایا پھر (اس کے اعضاء کو) درست کیا", "text_english": "Who created and proportioned", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5950.mp3"}, {"id": 5951, "surah_number": 87, "ayah_number_in_surah": 3, "global_ayah_number": 5951, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "text_urdu": "اور جس نے (اس کا) اندازہ ٹہرایا (پھر اس کو) رستہ بتایا", "text_english": "And who destined and [then] guided", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5951.mp3"}, {"id": 5952, "surah_number": 87, "ayah_number_in_surah": 4, "global_ayah_number": 5952, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "text_urdu": "اور جس نے چارہ اگایا", "text_english": "And who brings out the pasture", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5952.mp3"}, {"id": 5953, "surah_number": 87, "ayah_number_in_surah": 5, "global_ayah_number": 5953, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "text_urdu": "پھر اس کو سیاہ رنگ کا کوڑا کر دیا", "text_english": "And [then] makes it black stubble.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5953.mp3"}, {"id": 5954, "surah_number": 87, "ayah_number_in_surah": 6, "global_ayah_number": 5954, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "text_urdu": "ہم تمہیں پڑھا دیں گے کہ تم فراموش نہ کرو گے", "text_english": "We will make you recite, [O Muhammad], and you will not forget,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5954.mp3"}, {"id": 5955, "surah_number": 87, "ayah_number_in_surah": 7, "global_ayah_number": 5955, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "text_urdu": "مگر جو خدا چاہے۔ وہ کھلی بات کو بھی جانتا ہے اور چھپی کو بھی", "text_english": "Except what Allah should will. Indeed, He knows what is declared and what is hidden.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5955.mp3"}, {"id": 5956, "surah_number": 87, "ayah_number_in_surah": 8, "global_ayah_number": 5956, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "text_urdu": "ہم تم کو آسان طریقے کی توفیق دیں گے", "text_english": "And We will ease you toward ease.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5956.mp3"}, {"id": 5957, "surah_number": 87, "ayah_number_in_surah": 9, "global_ayah_number": 5957, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "text_urdu": "سو جہاں تک نصیحت (کے) نافع (ہونے کی امید) ہو نصیحت کرتے رہو", "text_english": "So remind, if the reminder should benefit;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5957.mp3"}, {"id": 5958, "surah_number": 87, "ayah_number_in_surah": 10, "global_ayah_number": 5958, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "text_urdu": "جو خوف رکھتا ہے وہ تو نصیحت پکڑے گا", "text_english": "He who fears [Allah] will be reminded.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5958.mp3"}, {"id": 5959, "surah_number": 87, "ayah_number_in_surah": 11, "global_ayah_number": 5959, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "text_urdu": "اور (بےخوف) بدبخت پہلو تہی کرے گا", "text_english": "But the wretched one will avoid it -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5959.mp3"}, {"id": 5960, "surah_number": 87, "ayah_number_in_surah": 12, "global_ayah_number": 5960, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "text_urdu": "جو (قیامت کو) بڑی (تیز) آگ میں داخل ہو گا", "text_english": "[He] who will [enter and] burn in the greatest Fire,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5960.mp3"}, {"id": 5961, "surah_number": 87, "ayah_number_in_surah": 13, "global_ayah_number": 5961, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "text_urdu": "پھر وہاں نہ مرے گا اور نہ جئے گا", "text_english": "Neither dying therein nor living.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5961.mp3"}, {"id": 5962, "surah_number": 87, "ayah_number_in_surah": 14, "global_ayah_number": 5962, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "text_urdu": "بے شک وہ مراد کو پہنچ گیا جو پاک ہوا", "text_english": "He has certainly succeeded who purifies himself", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5962.mp3"}, {"id": 5963, "surah_number": 87, "ayah_number_in_surah": 15, "global_ayah_number": 5963, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "sajda": false, "text_arabic": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "text_urdu": "اور اپنے پروردگار کے نام کا ذکر کرتا رہا اور نماز پڑھتا رہا", "text_english": "And mentions the name of his Lord and prays.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5963.mp3"}, {"id": 5964, "surah_number": 87, "ayah_number_in_surah": 16, "global_ayah_number": 5964, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false, "text_arabic": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "text_urdu": "مگر تم لوگ تو دنیا کی زندگی کو اختیار کرتے ہو", "text_english": "But you prefer the worldly life,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5964.mp3"}, {"id": 5965, "surah_number": 87, "ayah_number_in_surah": 17, "global_ayah_number": 5965, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false, "text_arabic": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "text_urdu": "حالانکہ آخرت بہت بہتر اور پائندہ تر ہے", "text_english": "While the Hereafter is better and more enduring.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5965.mp3"}, {"id": 5966, "surah_number": 87, "ayah_number_in_surah": 18, "global_ayah_number": 5966, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false, "text_arabic": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "text_urdu": "یہ بات پہلے صحیفوں میں (مرقوم) ہے", "text_english": "Indeed, this is in the former scriptures,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5966.mp3"}, {"id": 5967, "surah_number": 87, "ayah_number_in_surah": 19, "global_ayah_number": 5967, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "sajda": false, "text_arabic": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "text_urdu": "(یعنی) ابراہیم اور موسیٰ کے صحیفوں میں", "text_english": "The scriptures of Abraham and Moses.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5967.mp3"}]