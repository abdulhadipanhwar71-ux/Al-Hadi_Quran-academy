[{"id": 6107, "surah_number": 96, "ayah_number_in_surah": 1, "global_ayah_number": 6107, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "text_urdu": "(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا", "text_english": "Recite in the name of your Lord who created -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6107.mp3"}, {"id": 6108, "surah_number": 96, "ayah_number_in_surah": 2, "global_ayah_number": 6108, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "text_urdu": "جس نے انسان کو خون کی پھٹکی سے بنایا", "text_english": "Created man from a clinging substance.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6108.mp3"}, {"id": 6109, "surah_number": 96, "ayah_number_in_surah": 3, "global_ayah_number": 6109, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "text_urdu": "پڑھو اور تمہارا پروردگار بڑا کریم ہے", "text_english": "Recite, and your Lord is the most Generous -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6109.mp3"}, {"id": 6110, "surah_number": 96, "ayah_number_in_surah": 4, "global_ayah_number": 6110, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "text_urdu": "جس نے قلم کے ذریعے سے علم سکھایا", "text_english": "Who taught by the pen -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6110.mp3"}, {"id": 6111, "surah_number": 96, "ayah_number_in_surah": 5, "global_ayah_number": 6111, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "text_urdu": "اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا", "text_english": "Taught man that which he knew not.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6111.mp3"}, {"id": 6112, "surah_number": 96, "ayah_number_in_surah": 6, "global_ayah_number": 6112, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "text_urdu": "مگر انسان سرکش ہو جاتا ہے", "text_english": "No! [But] indeed, man transgresses", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6112.mp3"}, {"id": 6113, "surah_number": 96, "ayah_number_in_surah": 7, "global_ayah_number": 6113, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "text_urdu": "جب کہ اپنے تیئں غنی دیکھتا ہے", "text_english": "Because he sees himself self-sufficient.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6113.mp3"}, {"id": 6114, "surah_number": 96, "ayah_number_in_surah": 8, "global_ayah_number": 6114, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "text_urdu": "کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے", "text_english": "Indeed, to your Lord is the return.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6114.mp3"}, {"id": 6115, "surah_number": 96, "ayah_number_in_surah": 9, "global_ayah_number": 6115, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "text_urdu": "بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے", "text_english": "Have you seen the one who forbids", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6115.mp3"}, {"id": 6116, "surah_number": 96, "ayah_number_in_surah": 10, "global_ayah_number": 6116, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "عَبْدًا إِذَا صَلَّىٰٓ", "text_urdu": "(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے", "text_english": "A servant when he prays?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6116.mp3"}, {"id": 6117, "surah_number": 96, "ayah_number_in_surah": 11, "global_ayah_number": 6117, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "text_urdu": "بھلا دیکھو تو اگر یہ راہِ راست پر ہو", "text_english": "Have you seen if he is upon guidance", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6117.mp3"}, {"id": 6118, "surah_number": 96, "ayah_number_in_surah": 12, "global_ayah_number": 6118, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "text_urdu": "یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)", "text_english": "Or enjoins righteousness?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6118.mp3"}, {"id": 6119, "surah_number": 96, "ayah_number_in_surah": 13, "global_ayah_number": 6119, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "text_urdu": "اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)", "text_english": "Have you seen if he denies and turns away -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6119.mp3"}, {"id": 6120, "surah_number": 96, "ayah_number_in_surah": 14, "global_ayah_number": 6120, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "text_urdu": "کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے", "text_english": "Does he not know that Allah sees?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6120.mp3"}, {"id": 6121, "surah_number": 96, "ayah_number_in_surah": 15, "global_ayah_number": 6121, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "text_urdu": "دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے", "text_english": "No! If he does not desist, We will surely drag him by the forelock -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6121.mp3"}, {"id": 6122, "surah_number": 96, "ayah_number_in_surah": 16, "global_ayah_number": 6122, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "text_urdu": "یعنی اس جھوٹے خطاکار کی پیشانی کے بال", "text_english": "A lying, sinning forelock.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6122.mp3"}, {"id": 6123, "surah_number": 96, "ayah_number_in_surah": 17, "global_ayah_number": 6123, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "فَلْيَدْعُ نَادِيَهُۥ", "text_urdu": "تو وہ اپنے یاروں کی مجلس کو بلالے", "text_english": "Then let him call his associates;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6123.mp3"}, {"id": 6124, "surah_number": 96, "ayah_number_in_surah": 18, "global_ayah_number": 6124, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": false, "text_arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ", "text_urdu": "ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے", "text_english": "We will call the angels of Hell.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6124.mp3"}, {"id": 6125, "surah_number": 96, "ayah_number_in_surah": 19, "global_ayah_number": 6125, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "sajda": true, "text_arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "text_urdu": "دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا", "text_english": "No! Do not obey him. But prostrate and draw near [to Allah].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6125.mp3"}]