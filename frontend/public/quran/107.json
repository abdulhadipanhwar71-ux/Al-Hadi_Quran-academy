[{"id": 6198, "surah_number": 107, "ayah_number_in_surah": 1, "global_ayah_number": 6198, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "text_urdu": "بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟", "text_english": "Have you seen the one who denies the Recompense?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6198.mp3"}, {"id": 6199, "surah_number": 107, "ayah_number_in_surah": 2, "global_ayah_number": 6199, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "text_urdu": "یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے", "text_english": "For that is the one who drives away the orphan", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6199.mp3"}, {"id": 6200, "surah_number": 107, "ayah_number_in_surah": 3, "global_ayah_number": 6200, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "text_urdu": "اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا", "text_english": "And does not encourage the feeding of the poor.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6200.mp3"}, {"id": 6201, "surah_number": 107, "ayah_number_in_surah": 4, "global_ayah_number": 6201, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "text_urdu": "تو ایسے نمازیوں کی خرابی ہے", "text_english": "So woe to those who pray", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6201.mp3"}, {"id": 6202, "surah_number": 107, "ayah_number_in_surah": 5, "global_ayah_number": 6202, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "text_urdu": "جو نماز کی طرف سے غافل رہتے ہیں", "text_english": "[But] who are heedless of their prayer -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6202.mp3"}, {"id": 6203, "surah_number": 107, "ayah_number_in_surah": 6, "global_ayah_number": 6203, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "text_urdu": "جو ریا کاری کرتے ہیں", "text_english": "Those who make show [of their deeds]", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6203.mp3"}, {"id": 6204, "surah_number": 107, "ayah_number_in_surah": 7, "global_ayah_number": 6204, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "sajda": false, "text_arabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "text_urdu": "اور برتنے کی چیزیں عاریتہً نہیں دیتے", "text_english": "And withhold [simple] assistance.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6204.mp3"}]