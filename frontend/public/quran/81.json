[{"id": 5801, "surah_number": 81, "ayah_number_in_surah": 1, "global_ayah_number": 5801, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "text_urdu": "جب سورج لپیٹ لیا جائے گا", "text_english": "When the sun is wrapped up [in darkness]", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5801.mp3"}, {"id": 5802, "surah_number": 81, "ayah_number_in_surah": 2, "global_ayah_number": 5802, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "text_urdu": "جب تارے بےنور ہو جائیں گے", "text_english": "And when the stars fall, dispersing,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5802.mp3"}, {"id": 5803, "surah_number": 81, "ayah_number_in_surah": 3, "global_ayah_number": 5803, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "text_urdu": "اور جب پہاڑ چلائے جائیں گے", "text_english": "And when the mountains are removed", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5803.mp3"}, {"id": 5804, "surah_number": 81, "ayah_number_in_surah": 4, "global_ayah_number": 5804, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "text_urdu": "اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی", "text_english": "And when full-term she-camels are neglected", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5804.mp3"}, {"id": 5805, "surah_number": 81, "ayah_number_in_surah": 5, "global_ayah_number": 5805, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "text_urdu": "اور جب وحشی جانور جمع اکٹھے ہو جائیں گے", "text_english": "And when the wild beasts are gathered", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5805.mp3"}, {"id": 5806, "surah_number": 81, "ayah_number_in_surah": 6, "global_ayah_number": 5806, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "text_urdu": "اور جب دریا آگ ہو جائیں گے", "text_english": "And when the seas are filled with flame", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5806.mp3"}, {"id": 5807, "surah_number": 81, "ayah_number_in_surah": 7, "global_ayah_number": 5807, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "text_urdu": "اور جب روحیں (بدنوں سے) ملا دی جائیں گی", "text_english": "And when the souls are paired", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5807.mp3"}, {"id": 5808, "surah_number": 81, "ayah_number_in_surah": 8, "global_ayah_number": 5808, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "text_urdu": "اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا", "text_english": "And when the girl [who was] buried alive is asked", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5808.mp3"}, {"id": 5809, "surah_number": 81, "ayah_number_in_surah": 9, "global_ayah_number": 5809, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "text_urdu": "کہ وہ کس گناہ پرماری گئی", "text_english": "For what sin she was killed", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5809.mp3"}, {"id": 5810, "surah_number": 81, "ayah_number_in_surah": 10, "global_ayah_number": 5810, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "text_urdu": "اور جب (عملوں کے) دفتر کھولے جائیں گے", "text_english": "And when the pages are made public", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5810.mp3"}, {"id": 5811, "surah_number": 81, "ayah_number_in_surah": 11, "global_ayah_number": 5811, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "text_urdu": "اور جب آسمانوں کی کھال کھینچ لی جائے گی", "text_english": "And when the sky is stripped away", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5811.mp3"}, {"id": 5812, "surah_number": 81, "ayah_number_in_surah": 12, "global_ayah_number": 5812, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "text_urdu": "اور جب دوزخ (کی آگ) بھڑکائی جائے گی", "text_english": "And when Hellfire is set ablaze", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5812.mp3"}, {"id": 5813, "surah_number": 81, "ayah_number_in_surah": 13, "global_ayah_number": 5813, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "text_urdu": "اور بہشت جب قریب لائی جائے گی", "text_english": "And when Paradise is brought near,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5813.mp3"}, {"id": 5814, "surah_number": 81, "ayah_number_in_surah": 14, "global_ayah_number": 5814, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "text_urdu": "تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے", "text_english": "A soul will [then] know what it has brought [with it].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5814.mp3"}, {"id": 5815, "surah_number": 81, "ayah_number_in_surah": 15, "global_ayah_number": 5815, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "text_urdu": "ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں", "text_english": "So I swear by the retreating stars -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5815.mp3"}, {"id": 5816, "surah_number": 81, "ayah_number_in_surah": 16, "global_ayah_number": 5816, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "ٱلْجَوَارِ ٱلْكُنَّسِ", "text_urdu": "(اور) جو سیر کرتے اور غائب ہو جاتے ہیں", "text_english": "Those that run [their courses] and disappear -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5816.mp3"}, {"id": 5817, "surah_number": 81, "ayah_number_in_surah": 17, "global_ayah_number": 5817, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "text_urdu": "اور رات کی قسم جب ختم ہونے لگتی ہے", "text_english": "And by the night as it closes in", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5817.mp3"}, {"id": 5818, "surah_number": 81, "ayah_number_in_surah": 18, "global_ayah_number": 5818, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "text_urdu": "اور صبح کی قسم جب نمودار ہوتی ہے", "text_english": "And by the dawn when it breathes", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5818.mp3"}, {"id": 5819, "surah_number": 81, "ayah_number_in_surah": 19, "global_ayah_number": 5819, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "text_urdu": "کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے", "text_english": "[That] indeed, the Qur'an is a word [conveyed by] a noble messenger", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5819.mp3"}, {"id": 5820, "surah_number": 81, "ayah_number_in_surah": 20, "global_ayah_number": 5820, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "text_urdu": "جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے", "text_english": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5820.mp3"}, {"id": 5821, "surah_number": 81, "ayah_number_in_surah": 21, "global_ayah_number": 5821, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "text_urdu": "سردار (اور) امانت دار ہے", "text_english": "Obeyed there [in the heavens] and trustworthy.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5821.mp3"}, {"id": 5822, "surah_number": 81, "ayah_number_in_surah": 22, "global_ayah_number": 5822, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "text_urdu": "اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں", "text_english": "And your companion is not [at all] mad.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5822.mp3"}, {"id": 5823, "surah_number": 81, "ayah_number_in_surah": 23, "global_ayah_number": 5823, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "text_urdu": "بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے", "text_english": "And he has already seen Gabriel in the clear horizon.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5823.mp3"}, {"id": 5824, "surah_number": 81, "ayah_number_in_surah": 24, "global_ayah_number": 5824, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "text_urdu": "اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں", "text_english": "And Muhammad is not a withholder of [knowledge of] the unseen.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5824.mp3"}, {"id": 5825, "surah_number": 81, "ayah_number_in_surah": 25, "global_ayah_number": 5825, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "text_urdu": "اور یہ شیطان مردود کا کلام نہیں", "text_english": "And the Qur'an is not the word of a devil, expelled [from the heavens].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5825.mp3"}, {"id": 5826, "surah_number": 81, "ayah_number_in_surah": 26, "global_ayah_number": 5826, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "فَأَيْنَ تَذْهَبُونَ", "text_urdu": "پھر تم کدھر جا رہے ہو", "text_english": "So where are you going?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5826.mp3"}, {"id": 5827, "surah_number": 81, "ayah_number_in_surah": 27, "global_ayah_number": 5827, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "text_urdu": "یہ تو جہان کے لوگوں کے لیے نصیحت ہے", "text_english": "It is not except a reminder to the worlds", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5827.mp3"}, {"id": 5828, "surah_number": 81, "ayah_number_in_surah": 28, "global_ayah_number": 5828, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "text_urdu": "(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے", "text_english": "For whoever wills among you to take a right course.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5828.mp3"}, {"id": 5829, "surah_number": 81, "ayah_number_in_surah": 29, "global_ayah_number": 5829, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "sajda": false, "text_arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "text_urdu": "اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے", "text_english": "And you do not will except that Allah wills - Lord of the worlds.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5829.mp3"}]