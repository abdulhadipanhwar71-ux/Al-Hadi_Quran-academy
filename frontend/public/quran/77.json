[{"id": 5623, "surah_number": 77, "ayah_number_in_surah": 1, "global_ayah_number": 5623, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "text_urdu": "ہواؤں کی قسم جو نرم نرم چلتی ہیں", "text_english": "By those [winds] sent forth in gusts", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5623.mp3"}, {"id": 5624, "surah_number": 77, "ayah_number_in_surah": 2, "global_ayah_number": 5624, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "text_urdu": "پھر زور پکڑ کر جھکڑ ہو جاتی ہیں", "text_english": "And the winds that blow violently", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5624.mp3"}, {"id": 5625, "surah_number": 77, "ayah_number_in_surah": 3, "global_ayah_number": 5625, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "text_urdu": "اور (بادلوں کو) پھاڑ کر پھیلا دیتی ہیں", "text_english": "And [by] the winds that spread [clouds]", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5625.mp3"}, {"id": 5626, "surah_number": 77, "ayah_number_in_surah": 4, "global_ayah_number": 5626, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "text_urdu": "پھر ان کو پھاڑ کر جدا جدا کر دیتی ہیں", "text_english": "And those [angels] who bring criterion", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5626.mp3"}, {"id": 5627, "surah_number": 77, "ayah_number_in_surah": 5, "global_ayah_number": 5627, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "text_urdu": "پھر فرشتوں کی قسم جو وحی لاتے ہیں", "text_english": "And those [angels] who deliver a message", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5627.mp3"}, {"id": 5628, "surah_number": 77, "ayah_number_in_surah": 6, "global_ayah_number": 5628, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "عُذْرًا أَوْ نُذْرًا", "text_urdu": "تاکہ عذر (رفع) کردیا جائے یا ڈر سنا دیا جائے", "text_english": "As justification or warning,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5628.mp3"}, {"id": 5629, "surah_number": 77, "ayah_number_in_surah": 7, "global_ayah_number": 5629, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "text_urdu": "کہ جس بات کا تم سے وعدہ کیا جاتا ہے وہ ہو کر رہے گی", "text_english": "Indeed, what you are promised is to occur.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5629.mp3"}, {"id": 5630, "surah_number": 77, "ayah_number_in_surah": 8, "global_ayah_number": 5630, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "text_urdu": "جب تاروں کی چمک جاتی رہے", "text_english": "So when the stars are obliterated", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5630.mp3"}, {"id": 5631, "surah_number": 77, "ayah_number_in_surah": 9, "global_ayah_number": 5631, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "text_urdu": "اور جب آسمان پھٹ جائے", "text_english": "And when the heaven is opened", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5631.mp3"}, {"id": 5632, "surah_number": 77, "ayah_number_in_surah": 10, "global_ayah_number": 5632, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "text_urdu": "اور جب پہاڑ اُڑے اُڑے پھریں", "text_english": "And when the mountains are blown away", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5632.mp3"}, {"id": 5633, "surah_number": 77, "ayah_number_in_surah": 11, "global_ayah_number": 5633, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "text_urdu": "اور جب پیغمبر فراہم کئے جائیں", "text_english": "And when the messengers' time has come...", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5633.mp3"}, {"id": 5634, "surah_number": 77, "ayah_number_in_surah": 12, "global_ayah_number": 5634, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "text_urdu": "بھلا (ان امور میں) تاخیر کس دن کے لئے کی گئی؟", "text_english": "For what Day was it postponed?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5634.mp3"}, {"id": 5635, "surah_number": 77, "ayah_number_in_surah": 13, "global_ayah_number": 5635, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "لِيَوْمِ ٱلْفَصْلِ", "text_urdu": "فیصلے کے دن کے لئے", "text_english": "For the Day of Judgement.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5635.mp3"}, {"id": 5636, "surah_number": 77, "ayah_number_in_surah": 14, "global_ayah_number": 5636, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "text_urdu": "اور تمہیں کیا خبر کہ فیصلے کا دن کیا ہے؟", "text_english": "And what can make you know what is the Day of Judgement?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5636.mp3"}, {"id": 5637, "surah_number": 77, "ayah_number_in_surah": 15, "global_ayah_number": 5637, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کے لئے خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5637.mp3"}, {"id": 5638, "surah_number": 77, "ayah_number_in_surah": 16, "global_ayah_number": 5638, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "text_urdu": "کیا ہم نے پہلے لوگوں کو ہلاک نہیں کر ڈالا", "text_english": "Did We not destroy the former peoples?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5638.mp3"}, {"id": 5639, "surah_number": 77, "ayah_number_in_surah": 17, "global_ayah_number": 5639, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "text_urdu": "پھر ان پچھلوں کو بھی ان کے پیچھے بھیج دیتے ہیں", "text_english": "Then We will follow them with the later ones.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5639.mp3"}, {"id": 5640, "surah_number": 77, "ayah_number_in_surah": 18, "global_ayah_number": 5640, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "text_urdu": "ہم گنہگاروں کے ساتھ ایسا ہی کیا کرتے ہیں", "text_english": "Thus do We deal with the criminals.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5640.mp3"}, {"id": 5641, "surah_number": 77, "ayah_number_in_surah": 19, "global_ayah_number": 5641, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5641.mp3"}, {"id": 5642, "surah_number": 77, "ayah_number_in_surah": 20, "global_ayah_number": 5642, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "text_urdu": "کیا ہم نے تم کو حقیر پانی سے نہیں پیدا کیا؟", "text_english": "Did We not create you from a liquid disdained?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5642.mp3"}, {"id": 5643, "surah_number": 77, "ayah_number_in_surah": 21, "global_ayah_number": 5643, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "text_urdu": "اس کو ایک محفوظ جگہ میں رکھا", "text_english": "And We placed it in a firm lodging", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5643.mp3"}, {"id": 5644, "surah_number": 77, "ayah_number_in_surah": 22, "global_ayah_number": 5644, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "text_urdu": "ایک وقت معین تک", "text_english": "For a known extent.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5644.mp3"}, {"id": 5645, "surah_number": 77, "ayah_number_in_surah": 23, "global_ayah_number": 5645, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "text_urdu": "پھر اندازہ مقرر کیا اور ہم کیا ہی خوب اندازہ مقرر کرنے والے ہیں", "text_english": "And We determined [it], and excellent [are We] to determine.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5645.mp3"}, {"id": 5646, "surah_number": 77, "ayah_number_in_surah": 24, "global_ayah_number": 5646, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5646.mp3"}, {"id": 5647, "surah_number": 77, "ayah_number_in_surah": 25, "global_ayah_number": 5647, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "text_urdu": "کیا ہم نے زمین کو سمیٹنے والی نہیں بنایا", "text_english": "Have We not made the earth a container", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5647.mp3"}, {"id": 5648, "surah_number": 77, "ayah_number_in_surah": 26, "global_ayah_number": 5648, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "text_urdu": "یعنی) زندوں اور مردوں کو", "text_english": "Of the living and the dead?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5648.mp3"}, {"id": 5649, "surah_number": 77, "ayah_number_in_surah": 27, "global_ayah_number": 5649, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "text_urdu": "(بنایا) اور اس پر اونچے اونچے پہاڑ رکھ دیئے اور تم لوگوں کو میٹھا پانی پلایا", "text_english": "And We placed therein lofty, firmly set mountains and have given you to drink sweet water.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5649.mp3"}, {"id": 5650, "surah_number": 77, "ayah_number_in_surah": 28, "global_ayah_number": 5650, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5650.mp3"}, {"id": 5651, "surah_number": 77, "ayah_number_in_surah": 29, "global_ayah_number": 5651, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "text_urdu": "جس چیز کو تم جھٹلایا کرتے تھے۔ (اب) اس کی طرف چلو", "text_english": "[They will be told], \"Proceed to that which you used to deny.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5651.mp3"}, {"id": 5652, "surah_number": 77, "ayah_number_in_surah": 30, "global_ayah_number": 5652, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "text_urdu": "(یعنی) اس سائے کی طرف چلو جس کی تین شاخیں ہیں", "text_english": "Proceed to a shadow [of smoke] having three columns", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5652.mp3"}, {"id": 5653, "surah_number": 77, "ayah_number_in_surah": 31, "global_ayah_number": 5653, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "text_urdu": "نہ ٹھنڈی چھاؤں اور نہ لپٹ سے بچاؤ", "text_english": "[But having] no cool shade and availing not against the flame.\"", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5653.mp3"}, {"id": 5654, "surah_number": 77, "ayah_number_in_surah": 32, "global_ayah_number": 5654, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "text_urdu": "اس سے (آگ کی اتنی اتنی بڑی) چنگاریاں اُڑتی ہیں جیسے محل", "text_english": "Indeed, it throws sparks [as huge] as a fortress,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5654.mp3"}, {"id": 5655, "surah_number": 77, "ayah_number_in_surah": 33, "global_ayah_number": 5655, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "text_urdu": "گویا زرد رنگ کے اونٹ ہیں", "text_english": "As if they were yellowish [black] camels.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5655.mp3"}, {"id": 5656, "surah_number": 77, "ayah_number_in_surah": 34, "global_ayah_number": 5656, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5656.mp3"}, {"id": 5657, "surah_number": 77, "ayah_number_in_surah": 35, "global_ayah_number": 5657, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "text_urdu": "یہ وہ دن ہے کہ (لوگ) لب تک نہ ہلا سکیں گے", "text_english": "This is a Day they will not speak,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5657.mp3"}, {"id": 5658, "surah_number": 77, "ayah_number_in_surah": 36, "global_ayah_number": 5658, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "text_urdu": "اور نہ ان کو اجازت دی جائے گی کہ عذر کرسکیں", "text_english": "Nor will it be permitted for them to make an excuse.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5658.mp3"}, {"id": 5659, "surah_number": 77, "ayah_number_in_surah": 37, "global_ayah_number": 5659, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5659.mp3"}, {"id": 5660, "surah_number": 77, "ayah_number_in_surah": 38, "global_ayah_number": 5660, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "text_urdu": "یہی فیصلے کا دن ہے (جس میں) ہم نے تم کو اور پہلے لوگوں کو جمع کیا ہے", "text_english": "This is the Day of Judgement; We will have assembled you and the former peoples.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5660.mp3"}, {"id": 5661, "surah_number": 77, "ayah_number_in_surah": 39, "global_ayah_number": 5661, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "text_urdu": "اگر تم کو کوئی داؤں آتا ہو تو مجھ سے کر لو", "text_english": "So if you have a plan, then plan against Me.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5661.mp3"}, {"id": 5662, "surah_number": 77, "ayah_number_in_surah": 40, "global_ayah_number": 5662, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5662.mp3"}, {"id": 5663, "surah_number": 77, "ayah_number_in_surah": 41, "global_ayah_number": 5663, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "text_urdu": "بےشک پرہیزگار سایوں اور چشموں میں ہوں گے", "text_english": "Indeed, the righteous will be among shades and springs", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5663.mp3"}, {"id": 5664, "surah_number": 77, "ayah_number_in_surah": 42, "global_ayah_number": 5664, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "text_urdu": "اور میؤوں میں جو ان کو مرغوب ہوں", "text_english": "And fruits from whatever they desire,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5664.mp3"}, {"id": 5665, "surah_number": 77, "ayah_number_in_surah": 43, "global_ayah_number": 5665, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "text_urdu": "اور جو عمل تم کرتے رہے تھے ان کے بدلے میں مزے سے کھاؤ اور پیو", "text_english": "[Being told], \"Eat and drink in satisfaction for what you used to do.\"", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5665.mp3"}, {"id": 5666, "surah_number": 77, "ayah_number_in_surah": 44, "global_ayah_number": 5666, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "text_urdu": "ہم نیکو کاروں کو ایسا ہی بدلہ دیا کرتے ہیں", "text_english": "Indeed, We thus reward the doers of good.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5666.mp3"}, {"id": 5667, "surah_number": 77, "ayah_number_in_surah": 45, "global_ayah_number": 5667, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہوگی", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5667.mp3"}, {"id": 5668, "surah_number": 77, "ayah_number_in_surah": 46, "global_ayah_number": 5668, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "text_urdu": "(اے جھٹلانے والو!) تم کسی قدر کھا لو اور فائدے اُٹھا لو تم بےشک گنہگار ہو", "text_english": "[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5668.mp3"}, {"id": 5669, "surah_number": 77, "ayah_number_in_surah": 47, "global_ayah_number": 5669, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5669.mp3"}, {"id": 5670, "surah_number": 77, "ayah_number_in_surah": 48, "global_ayah_number": 5670, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "text_urdu": "اور جب ان سے کہا جاتا ہے کہ (خدا کے آگے) جھکو تو جھکتے نہیں", "text_english": "And when it is said to them, \"Bow [in prayer],\" they do not bow.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5670.mp3"}, {"id": 5671, "surah_number": 77, "ayah_number_in_surah": 49, "global_ayah_number": 5671, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "text_urdu": "اس دن جھٹلانے والوں کی خرابی ہے", "text_english": "Woe, that Day, to the deniers.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5671.mp3"}, {"id": 5672, "surah_number": 77, "ayah_number_in_surah": 50, "global_ayah_number": 5672, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "sajda": false, "text_arabic": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "text_urdu": "اب اس کے بعد یہ کون سی بات پر ایمان لائیں گے؟", "text_english": "Then in what statement after the Qur'an will they believe?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5672.mp3"}]