[{"id": 6158, "surah_number": 101, "ayah_number_in_surah": 1, "global_ayah_number": 6158, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "text_urdu": "کھڑ کھڑانے والی", "text_english": "The Striking Calamity -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6158.mp3"}, {"id": 6159, "surah_number": 101, "ayah_number_in_surah": 2, "global_ayah_number": 6159, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "مَا ٱلْقَارِعَةُ", "text_urdu": "کھڑ کھڑانے والی کیا ہے؟", "text_english": "What is the Striking Calamity?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6159.mp3"}, {"id": 6160, "surah_number": 101, "ayah_number_in_surah": 3, "global_ayah_number": 6160, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "text_urdu": "اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟", "text_english": "And what can make you know what is the Striking Calamity?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6160.mp3"}, {"id": 6161, "surah_number": 101, "ayah_number_in_surah": 4, "global_ayah_number": 6161, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "text_urdu": "(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے", "text_english": "It is the Day when people will be like moths, dispersed,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6161.mp3"}, {"id": 6162, "surah_number": 101, "ayah_number_in_surah": 5, "global_ayah_number": 6162, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "text_urdu": "اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون", "text_english": "And the mountains will be like wool, fluffed up.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6162.mp3"}, {"id": 6163, "surah_number": 101, "ayah_number_in_surah": 6, "global_ayah_number": 6163, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "text_urdu": "تو جس کے (اعمال کے) وزن بھاری نکلیں گے", "text_english": "Then as for one whose scales are heavy [with good deeds],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6163.mp3"}, {"id": 6164, "surah_number": 101, "ayah_number_in_surah": 7, "global_ayah_number": 6164, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "text_urdu": "وہ دل پسند عیش میں ہو گا", "text_english": "He will be in a pleasant life.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6164.mp3"}, {"id": 6165, "surah_number": 101, "ayah_number_in_surah": 8, "global_ayah_number": 6165, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "text_urdu": "اور جس کے وزن ہلکے نکلیں گے", "text_english": "But as for one whose scales are light,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6165.mp3"}, {"id": 6166, "surah_number": 101, "ayah_number_in_surah": 9, "global_ayah_number": 6166, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "فَأُمُّهُۥ هَاوِيَةٌۭ", "text_urdu": "اس کا مرجع ہاویہ ہے", "text_english": "His refuge will be an abyss.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6166.mp3"}, {"id": 6167, "surah_number": 101, "ayah_number_in_surah": 10, "global_ayah_number": 6167, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "text_urdu": "اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟", "text_english": "And what can make you know what that is?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6167.mp3"}, {"id": 6168, "surah_number": 101, "ayah_number_in_surah": 11, "global_ayah_number": 6168, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "sajda": false, "text_arabic": "نَارٌ حَامِيَةٌۢ", "text_urdu": "دہکتی ہوئی آگ ہے", "text_english": "It is a Fire, intensely hot.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6168.mp3"}]