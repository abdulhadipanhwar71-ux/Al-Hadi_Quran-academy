[{"id": 6231, "surah_number": 114, "ayah_number_in_surah": 1, "global_ayah_number": 6231, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "text_urdu": "کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں", "text_english": "Say, \"I seek refuge in the Lord of mankind,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6231.mp3"}, {"id": 6232, "surah_number": 114, "ayah_number_in_surah": 2, "global_ayah_number": 6232, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "مَلِكِ ٱلنَّاسِ", "text_urdu": "(یعنی) لوگوں کے حقیقی بادشاہ کی", "text_english": "The Sovereign of mankind.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6232.mp3"}, {"id": 6233, "surah_number": 114, "ayah_number_in_surah": 3, "global_ayah_number": 6233, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "إِلَٰهِ ٱلنَّاسِ", "text_urdu": "لوگوں کے معبود برحق کی", "text_english": "The God of mankind,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6233.mp3"}, {"id": 6234, "surah_number": 114, "ayah_number_in_surah": 4, "global_ayah_number": 6234, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "text_urdu": "(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے", "text_english": "From the evil of the retreating whisperer -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6234.mp3"}, {"id": 6235, "surah_number": 114, "ayah_number_in_surah": 5, "global_ayah_number": 6235, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "text_urdu": "جو لوگوں کے دلوں میں وسوسے ڈالتا ہے", "text_english": "Who whispers [evil] into the breasts of mankind -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6235.mp3"}, {"id": 6236, "surah_number": 114, "ayah_number_in_surah": 6, "global_ayah_number": 6236, "juz": 30, "manzil": 7, "page": 604, "ruku": 556, "sajda": false, "text_arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "text_urdu": "وہ جنّات میں سے (ہو) یا انسانوں میں سے", "text_english": "From among the jinn and mankind.\"", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6236.mp3"}]