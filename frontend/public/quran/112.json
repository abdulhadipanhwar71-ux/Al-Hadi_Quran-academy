[{"id": 6222, "surah_number": 112, "ayah_number_in_surah": 1, "global_ayah_number": 6222, "juz": 30, "manzil": 7, "page": 604, "ruku": 554, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ", "text_urdu": "کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے", "text_english": "Say, \"He is Allah, [who is] One,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6222.mp3"}, {"id": 6223, "surah_number": 112, "ayah_number_in_surah": 2, "global_ayah_number": 6223, "juz": 30, "manzil": 7, "page": 604, "ruku": 554, "sajda": false, "text_arabic": "ٱللَّهُ ٱلصَّمَدُ", "text_urdu": "معبود برحق جو بےنیاز ہے", "text_english": "Allah, the Eternal Refuge.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6223.mp3"}, {"id": 6224, "surah_number": 112, "ayah_number_in_surah": 3, "global_ayah_number": 6224, "juz": 30, "manzil": 7, "page": 604, "ruku": 554, "sajda": false, "text_arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "text_urdu": "نہ کسی کا باپ ہے اور نہ کسی کا بیٹا", "text_english": "He neither begets nor is born,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6224.mp3"}, {"id": 6225, "surah_number": 112, "ayah_number_in_surah": 4, "global_ayah_number": 6225, "juz": 30, "manzil": 7, "page": 604, "ruku": 554, "sajda": false, "text_arabic": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ", "text_urdu": "اور کوئی اس کا ہمسر نہیں", "text_english": "Nor is there to Him any equivalent.\"", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6225.mp3"}]