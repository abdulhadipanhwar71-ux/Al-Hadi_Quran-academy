[{"id": 6091, "surah_number": 94, "ayah_number_in_surah": 1, "global_ayah_number": 6091, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "text_urdu": "(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)", "text_english": "Did We not expand for you, [O Muhammad], your breast?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6091.mp3"}, {"id": 6092, "surah_number": 94, "ayah_number_in_surah": 2, "global_ayah_number": 6092, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "text_urdu": "اور تم پر سے بوجھ بھی اتار دیا", "text_english": "And We removed from you your burden", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6092.mp3"}, {"id": 6093, "surah_number": 94, "ayah_number_in_surah": 3, "global_ayah_number": 6093, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "text_urdu": "جس نے تمہاری پیٹھ توڑ رکھی تھی", "text_english": "Which had weighed upon your back", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6093.mp3"}, {"id": 6094, "surah_number": 94, "ayah_number_in_surah": 4, "global_ayah_number": 6094, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "text_urdu": "اور تمہارا ذکر بلند کیا", "text_english": "And raised high for you your repute.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6094.mp3"}, {"id": 6095, "surah_number": 94, "ayah_number_in_surah": 5, "global_ayah_number": 6095, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "text_urdu": "ہاں ہاں مشکل کے ساتھ آسانی بھی ہے", "text_english": "For indeed, with hardship [will be] ease.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6095.mp3"}, {"id": 6096, "surah_number": 94, "ayah_number_in_surah": 6, "global_ayah_number": 6096, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "text_urdu": "(اور) بے شک مشکل کے ساتھ آسانی ہے", "text_english": "Indeed, with hardship [will be] ease.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6096.mp3"}, {"id": 6097, "surah_number": 94, "ayah_number_in_surah": 7, "global_ayah_number": 6097, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "text_urdu": "تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو", "text_english": "So when you have finished [your duties], then stand up [for worship].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6097.mp3"}, {"id": 6098, "surah_number": 94, "ayah_number_in_surah": 8, "global_ayah_number": 6098, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "sajda": false, "text_arabic": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "text_urdu": "اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو", "text_english": "And to your Lord direct [your] longing.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6098.mp3"}]