[{"id": 6059, "surah_number": 92, "ayah_number_in_surah": 1, "global_ayah_number": 6059, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "text_urdu": "رات کی قسم جب (دن کو) چھپالے", "text_english": "By the night when it covers", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6059.mp3"}, {"id": 6060, "surah_number": 92, "ayah_number_in_surah": 2, "global_ayah_number": 6060, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "text_urdu": "اور دن کی قسم جب چمک اٹھے", "text_english": "And [by] the day when it appears", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6060.mp3"}, {"id": 6061, "surah_number": 92, "ayah_number_in_surah": 3, "global_ayah_number": 6061, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "text_urdu": "اور اس (ذات) کی قسم جس نے نر اور مادہ پیدا کیے", "text_english": "And [by] He who created the male and female,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6061.mp3"}, {"id": 6062, "surah_number": 92, "ayah_number_in_surah": 4, "global_ayah_number": 6062, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "text_urdu": "کہ تم لوگوں کی کوششں طرح طرح کی ہے", "text_english": "Indeed, your efforts are diverse.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6062.mp3"}, {"id": 6063, "surah_number": 92, "ayah_number_in_surah": 5, "global_ayah_number": 6063, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "text_urdu": "تو جس نے (خدا کے رستے میں مال) دیا اور پرہیز گاری کی", "text_english": "As for he who gives and fears Allah", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6063.mp3"}, {"id": 6064, "surah_number": 92, "ayah_number_in_surah": 6, "global_ayah_number": 6064, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "text_urdu": "اور نیک بات کو سچ جانا", "text_english": "And believes in the best [reward],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6064.mp3"}, {"id": 6065, "surah_number": 92, "ayah_number_in_surah": 7, "global_ayah_number": 6065, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "text_urdu": "اس کو ہم آسان طریقے کی توفیق دیں گے", "text_english": "We will ease him toward ease.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6065.mp3"}, {"id": 6066, "surah_number": 92, "ayah_number_in_surah": 8, "global_ayah_number": 6066, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "text_urdu": "اور جس نے بخل کیا اور بےپروا بنا رہا", "text_english": "But as for he who withholds and considers himself free of need", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6066.mp3"}, {"id": 6067, "surah_number": 92, "ayah_number_in_surah": 9, "global_ayah_number": 6067, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "text_urdu": "اور نیک بات کو جھوٹ سمجھا", "text_english": "And denies the best [reward],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6067.mp3"}, {"id": 6068, "surah_number": 92, "ayah_number_in_surah": 10, "global_ayah_number": 6068, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "text_urdu": "اسے سختی میں پہنچائیں گے", "text_english": "We will ease him toward difficulty.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6068.mp3"}, {"id": 6069, "surah_number": 92, "ayah_number_in_surah": 11, "global_ayah_number": 6069, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "text_urdu": "اور جب وہ (دوزخ کے گڑھے میں) گرے گا تو اس کا مال اس کے کچھ کام نہ آئے گا", "text_english": "And what will his wealth avail him when he falls?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6069.mp3"}, {"id": 6070, "surah_number": 92, "ayah_number_in_surah": 12, "global_ayah_number": 6070, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "text_urdu": "ہمیں تو راہ دکھا دینا ہے", "text_english": "Indeed, [incumbent] upon Us is guidance.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6070.mp3"}, {"id": 6071, "surah_number": 92, "ayah_number_in_surah": 13, "global_ayah_number": 6071, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "text_urdu": "اور آخرت او ردنیا ہماری ہی چیزیں ہیں", "text_english": "And indeed, to Us belongs the Hereafter and the first [life].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6071.mp3"}, {"id": 6072, "surah_number": 92, "ayah_number_in_surah": 14, "global_ayah_number": 6072, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "sajda": false, "text_arabic": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "text_urdu": "سو میں نے تم کو بھڑکتی آگ سے متنبہ کر دیا", "text_english": "So I have warned you of a Fire which is blazing.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6072.mp3"}, {"id": 6073, "surah_number": 92, "ayah_number_in_surah": 15, "global_ayah_number": 6073, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "text_urdu": "اس میں وہی داخل ہو گا جو بڑا بدبخت ہے", "text_english": "None will [enter to] burn therein except the most wretched one.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6073.mp3"}, {"id": 6074, "surah_number": 92, "ayah_number_in_surah": 16, "global_ayah_number": 6074, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "text_urdu": "جس نے جھٹلایا اور منہ پھیرا", "text_english": "Who had denied and turned away.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6074.mp3"}, {"id": 6075, "surah_number": 92, "ayah_number_in_surah": 17, "global_ayah_number": 6075, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "text_urdu": "اور جو بڑا پرہیزگار ہے وہ (اس سے) بچا لیا جائے گا", "text_english": "But the righteous one will avoid it -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6075.mp3"}, {"id": 6076, "surah_number": 92, "ayah_number_in_surah": 18, "global_ayah_number": 6076, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "text_urdu": "جو مال دیتا ہے تاکہ پاک ہو", "text_english": "[He] who gives [from] his wealth to purify himself", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6076.mp3"}, {"id": 6077, "surah_number": 92, "ayah_number_in_surah": 19, "global_ayah_number": 6077, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "text_urdu": "اور (اس لیے) نہیں (دیتا کہ) اس پر کسی کا احسان (ہے) جس کا وہ بدلہ اتارتا ہے", "text_english": "And not [giving] for anyone who has [done him] a favor to be rewarded", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6077.mp3"}, {"id": 6078, "surah_number": 92, "ayah_number_in_surah": 20, "global_ayah_number": 6078, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "text_urdu": "بلکہ اپنے خداوند اعلیٰ کی رضامندی حاصل کرنے کے لیے دیتا ہے", "text_english": "But only seeking the countenance of his Lord, Most High.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6078.mp3"}, {"id": 6079, "surah_number": 92, "ayah_number_in_surah": 21, "global_ayah_number": 6079, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "sajda": false, "text_arabic": "وَلَسَوْفَ يَرْضَىٰ", "text_urdu": "اور وہ عنقریب خوش ہو جائے گا", "text_english": "And he is going to be satisfied.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6079.mp3"}]