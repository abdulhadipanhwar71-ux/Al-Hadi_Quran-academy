[{"id": 5759, "surah_number": 80, "ayah_number_in_surah": 1, "global_ayah_number": 5759, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "text_urdu": "(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے", "text_english": "The Prophet frowned and turned away", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5759.mp3"}, {"id": 5760, "surah_number": 80, "ayah_number_in_surah": 2, "global_ayah_number": 5760, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "text_urdu": "کہ ان کے پاس ایک نابینا آیا", "text_english": "Because there came to him the blind man, [interrupting].", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5760.mp3"}, {"id": 5761, "surah_number": 80, "ayah_number_in_surah": 3, "global_ayah_number": 5761, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "text_urdu": "اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا", "text_english": "But what would make you perceive, [O Muhammad], that perhaps he might be purified", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5761.mp3"}, {"id": 5762, "surah_number": 80, "ayah_number_in_surah": 4, "global_ayah_number": 5762, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "text_urdu": "یا سوچتا تو سمجھانا اسے فائدہ دیتا", "text_english": "Or be reminded and the remembrance would benefit him?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5762.mp3"}, {"id": 5763, "surah_number": 80, "ayah_number_in_surah": 5, "global_ayah_number": 5763, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "text_urdu": "جو پروا نہیں کرتا", "text_english": "As for he who thinks himself without need,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5763.mp3"}, {"id": 5764, "surah_number": 80, "ayah_number_in_surah": 6, "global_ayah_number": 5764, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "text_urdu": "اس کی طرف تو تم توجہ کرتے ہو", "text_english": "To him you give attention.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5764.mp3"}, {"id": 5765, "surah_number": 80, "ayah_number_in_surah": 7, "global_ayah_number": 5765, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "text_urdu": "حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں", "text_english": "And not upon you [is any blame] if he will not be purified.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5765.mp3"}, {"id": 5766, "surah_number": 80, "ayah_number_in_surah": 8, "global_ayah_number": 5766, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "text_urdu": "اور جو تمہارے پاس دوڑتا ہوا آیا", "text_english": "But as for he who came to you striving [for knowledge]", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5766.mp3"}, {"id": 5767, "surah_number": 80, "ayah_number_in_surah": 9, "global_ayah_number": 5767, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَهُوَ يَخْشَىٰ", "text_urdu": "اور (خدا سے) ڈرتا ہے", "text_english": "While he fears [Allah],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5767.mp3"}, {"id": 5768, "surah_number": 80, "ayah_number_in_surah": 10, "global_ayah_number": 5768, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "text_urdu": "اس سے تم بےرخی کرتے ہو", "text_english": "From him you are distracted.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5768.mp3"}, {"id": 5769, "surah_number": 80, "ayah_number_in_surah": 11, "global_ayah_number": 5769, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "text_urdu": "دیکھو یہ (قرآن) نصیحت ہے", "text_english": "No! Indeed, these verses are a reminder;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5769.mp3"}, {"id": 5770, "surah_number": 80, "ayah_number_in_surah": 12, "global_ayah_number": 5770, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَمَن شَآءَ ذَكَرَهُۥ", "text_urdu": "پس جو چاہے اسے یاد رکھے", "text_english": "So whoever wills may remember it.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5770.mp3"}, {"id": 5771, "surah_number": 80, "ayah_number_in_surah": 13, "global_ayah_number": 5771, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "text_urdu": "قابل ادب ورقوں میں (لکھا ہوا)", "text_english": "[It is recorded] in honored sheets,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5771.mp3"}, {"id": 5772, "surah_number": 80, "ayah_number_in_surah": 14, "global_ayah_number": 5772, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "text_urdu": "جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں", "text_english": "Exalted and purified,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5772.mp3"}, {"id": 5773, "surah_number": 80, "ayah_number_in_surah": 15, "global_ayah_number": 5773, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "بِأَيْدِى سَفَرَةٍۢ", "text_urdu": "لکھنے والوں کے ہاتھوں میں", "text_english": "[Carried] by the hands of messenger-angels,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5773.mp3"}, {"id": 5774, "surah_number": 80, "ayah_number_in_surah": 16, "global_ayah_number": 5774, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "كِرَامٍۭ بَرَرَةٍۢ", "text_urdu": "جو سردار اور نیکو کار ہیں", "text_english": "Noble and dutiful.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5774.mp3"}, {"id": 5775, "surah_number": 80, "ayah_number_in_surah": 17, "global_ayah_number": 5775, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "text_urdu": "انسان ہلاک ہو جائے کیسا ناشکرا ہے", "text_english": "Cursed is man; how disbelieving is he.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5775.mp3"}, {"id": 5776, "surah_number": 80, "ayah_number_in_surah": 18, "global_ayah_number": 5776, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "text_urdu": "اُسے (خدا نے) کس چیز سے بنایا؟", "text_english": "From what substance did He create him?", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5776.mp3"}, {"id": 5777, "surah_number": 80, "ayah_number_in_surah": 19, "global_ayah_number": 5777, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "text_urdu": "نطفے سے بنایا پھر اس کا اندازہ مقرر کیا", "text_english": "From a sperm-drop He created him and destined for him;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5777.mp3"}, {"id": 5778, "surah_number": 80, "ayah_number_in_surah": 20, "global_ayah_number": 5778, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "text_urdu": "پھر اس کے لیے رستہ آسان کر دیا", "text_english": "Then He eased the way for him;", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5778.mp3"}, {"id": 5779, "surah_number": 80, "ayah_number_in_surah": 21, "global_ayah_number": 5779, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "text_urdu": "پھر اس کو موت دی پھر قبر میں دفن کرایا", "text_english": "Then He causes his death and provides a grave for him.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5779.mp3"}, {"id": 5780, "surah_number": 80, "ayah_number_in_surah": 22, "global_ayah_number": 5780, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "text_urdu": "پھر جب چاہے گا اسے اٹھا کھڑا کرے گا", "text_english": "Then when He wills, He will resurrect him.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5780.mp3"}, {"id": 5781, "surah_number": 80, "ayah_number_in_surah": 23, "global_ayah_number": 5781, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "text_urdu": "کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا", "text_english": "No! Man has not yet accomplished what He commanded him.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5781.mp3"}, {"id": 5782, "surah_number": 80, "ayah_number_in_surah": 24, "global_ayah_number": 5782, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "text_urdu": "تو انسان کو چاہیئے کہ اپنے کھانے کی طرف نظر کرے", "text_english": "Then let mankind look at his food -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5782.mp3"}, {"id": 5783, "surah_number": 80, "ayah_number_in_surah": 25, "global_ayah_number": 5783, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "text_urdu": "بے شک ہم ہی نے پانی برسایا", "text_english": "How We poured down water in torrents,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5783.mp3"}, {"id": 5784, "surah_number": 80, "ayah_number_in_surah": 26, "global_ayah_number": 5784, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "text_urdu": "پھر ہم ہی نے زمین کو چیرا پھاڑا", "text_english": "Then We broke open the earth, splitting [it with sprouts],", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5784.mp3"}, {"id": 5785, "surah_number": 80, "ayah_number_in_surah": 27, "global_ayah_number": 5785, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "text_urdu": "پھر ہم ہی نے اس میں اناج اگایا", "text_english": "And caused to grow within it grain", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5785.mp3"}, {"id": 5786, "surah_number": 80, "ayah_number_in_surah": 28, "global_ayah_number": 5786, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَعِنَبًۭا وَقَضْبًۭا", "text_urdu": "اور انگور اور ترکاری", "text_english": "And grapes and herbage", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5786.mp3"}, {"id": 5787, "surah_number": 80, "ayah_number_in_surah": 29, "global_ayah_number": 5787, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَزَيْتُونًۭا وَنَخْلًۭا", "text_urdu": "اور زیتون اور کھجوریں", "text_english": "And olive and palm trees", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5787.mp3"}, {"id": 5788, "surah_number": 80, "ayah_number_in_surah": 30, "global_ayah_number": 5788, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَحَدَآئِقَ غُلْبًۭا", "text_urdu": "اور گھنے گھنے باغ", "text_english": "And gardens of dense shrubbery", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5788.mp3"}, {"id": 5789, "surah_number": 80, "ayah_number_in_surah": 31, "global_ayah_number": 5789, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَفَٰكِهَةًۭ وَأَبًّۭا", "text_urdu": "اور میوے اور چارا", "text_english": "And fruit and grass -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5789.mp3"}, {"id": 5790, "surah_number": 80, "ayah_number_in_surah": 32, "global_ayah_number": 5790, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "text_urdu": "(یہ سب کچھ) تمہارے اور تمہارے چارپایوں کے لیے بنایا", "text_english": "[As] enjoyment for you and your grazing livestock.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5790.mp3"}, {"id": 5791, "surah_number": 80, "ayah_number_in_surah": 33, "global_ayah_number": 5791, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "text_urdu": "تو جب (قیامت کا) غل مچے گا", "text_english": "But when there comes the Deafening Blast", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5791.mp3"}, {"id": 5792, "surah_number": 80, "ayah_number_in_surah": 34, "global_ayah_number": 5792, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "text_urdu": "اس دن آدمی اپنے بھائی سے دور بھاگے گا", "text_english": "On the Day a man will flee from his brother", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5792.mp3"}, {"id": 5793, "surah_number": 80, "ayah_number_in_surah": 35, "global_ayah_number": 5793, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَأُمِّهِۦ وَأَبِيهِ", "text_urdu": "اور اپنی ماں اور اپنے باپ سے", "text_english": "And his mother and his father", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5793.mp3"}, {"id": 5794, "surah_number": 80, "ayah_number_in_surah": 36, "global_ayah_number": 5794, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "text_urdu": "اور اپنی بیوی اور اپنے بیٹے سے", "text_english": "And his wife and his children,", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5794.mp3"}, {"id": 5795, "surah_number": 80, "ayah_number_in_surah": 37, "global_ayah_number": 5795, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "text_urdu": "ہر شخص اس روز ایک فکر میں ہو گا جو اسے (مصروفیت کے لیے) بس کرے گا", "text_english": "For every man, that Day, will be a matter adequate for him.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5795.mp3"}, {"id": 5796, "surah_number": 80, "ayah_number_in_surah": 38, "global_ayah_number": 5796, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "text_urdu": "اور کتنے منہ اس روز چمک رہے ہوں گے", "text_english": "[Some] faces, that Day, will be bright -", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5796.mp3"}, {"id": 5797, "surah_number": 80, "ayah_number_in_surah": 39, "global_ayah_number": 5797, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "text_urdu": "خنداں و شاداں (یہ مومنان نیکو کار ہیں)", "text_english": "Laughing, rejoicing at good news.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5797.mp3"}, {"id": 5798, "surah_number": 80, "ayah_number_in_surah": 40, "global_ayah_number": 5798, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "text_urdu": "اور کتنے منہ ہوں گے جن پر گرد پڑ رہی ہو گی", "text_english": "And [other] faces, that Day, will have upon them dust.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5798.mp3"}, {"id": 5799, "surah_number": 80, "ayah_number_in_surah": 41, "global_ayah_number": 5799, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "تَرْهَقُهَا قَتَرَةٌ", "text_urdu": "(اور) سیاہی چڑھ رہی ہو گی", "text_english": "Blackness will cover them.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5799.mp3"}, {"id": 5800, "surah_number": 80, "ayah_number_in_surah": 42, "global_ayah_number": 5800, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "sajda": false, "text_arabic": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "text_urdu": "یہ کفار بدکردار ہیں", "text_english": "Those are the disbelievers, the wicked ones.", "audio_url": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5800.mp3"}]